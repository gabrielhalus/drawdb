PORT=3000

# Directory holding one JSON file per diagram
DIAGRAM_STORE_PATH=./data/diagrams

# SQLite file holding accounts and sessions
AUTH_DB_PATH=./data/auth.db

# Public URL of this instance. Set it in production: it is what marks the
# session cookie as secure over HTTPS. Defaults to http://localhost:$PORT.
# AUTH_BASE_URL=https://drawdb.example.com

# Extra origins allowed to call the API, comma separated. Only needed when a
# reverse proxy rewrites the Host header; same-origin requests always pass.
# AUTH_TRUSTED_ORIGINS=https://drawdb.example.com

# Signs session cookies. Generated once into ./data/auth.secret when unset;
# set it explicitly to share one value across several instances.
# BETTER_AUTH_SECRET=

# Keep registration open after the first account exists. Unset, only the very
# first account can be created and it owns the instance.
# ALLOW_SIGNUP=true
